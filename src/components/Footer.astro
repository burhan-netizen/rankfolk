---
import Logo from './Logo.astro';
import { SITE, CATEGORIES } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="mt-28 border-t-2 border-ink bg-ink text-white">
	<div class="container-wide grid gap-12 py-16 md:grid-cols-[1.5fr_1fr_1fr]">
		<div>
			<Logo invert />
			<p class="mt-5 max-w-sm font-display text-xl font-bold leading-tight">{SITE.tagline}.</p>
			<p class="mt-3 max-w-sm text-white/65">Practical guides for owners, written in plain English.</p>
		</div>
		<div>
			<h2 class="font-display text-sm font-bold uppercase tracking-widest text-sun">Topics</h2>
			<ul class="mt-5 space-y-3">
				{CATEGORIES.map((c) => <li><a class="text-white/85 hover:text-sun" href={`/category/${c.slug}/`}>{c.name}</a></li>)}
			</ul>
		</div>
		<div>
			<h2 class="font-display text-sm font-bold uppercase tracking-widest text-sun">Rankfolk</h2>
			<ul class="mt-5 space-y-3">
				<li><a class="text-white/85 hover:text-sun" href="/about/">About</a></li>
				<li><a class="text-white/85 hover:text-sun" href="/contact/">Contact</a></li>
				<li><a class="text-white/85 hover:text-sun" href="/privacy-policy/">Privacy Policy</a></li>
				<li><a class="text-white/85 hover:text-sun" href="/terms/">Terms of Use</a></li>
				<li><a class="text-white/85 hover:text-sun" href="/disclaimer/">Disclaimer</a></li>
				<li><a class="text-white/85 hover:text-sun" href="/affiliate-disclosure/">Affiliate Disclosure</a></li>
			</ul>
		</div>
	</div>
	<div class="overflow-hidden border-t-2 border-white/15">
		<p class="container-wide select-none py-2 font-display text-[15vw] font-extrabold leading-[0.9] tracking-[-0.03em] text-white/[0.06] md:text-[9rem]" aria-hidden="true">
			rankfolk
		</p>
	</div>
	<div class="border-t-2 border-white/15">
		<div class="container-wide flex flex-col gap-2 py-6 text-sm text-white/60 sm:flex-row sm:justify-between">
			<p>© {year} {SITE.name}. All rights reserved.</p>
			<p>Some links may be affiliate links. <a class="underline hover:text-sun" href="/affiliate-disclosure/">Learn more</a>.</p>
		</div>
	</div>
</footer>
