---
import Logo from './Logo.astro';
import { NAV } from '../site.config';
const path = Astro.url.pathname;
---

<div class="border-b-2 border-ink bg-ink text-center text-sm font-medium text-white">
	<p class="container-wide py-2">
		New: <a href="/tools/website-audit/" class="font-semibold text-sun underline decoration-2 underline-offset-2 hover:text-white">Free website audit for small businesses</a>
	</p>
</div>
<header class="sticky top-0 z-40 border-b-2 border-ink bg-paper/95 backdrop-blur">
	<div class="container-wide flex h-[4.5rem] items-center justify-between gap-4">
		<a href="/" aria-label="Rankfolk home"><Logo /></a>

		<nav aria-label="Main" class="hidden lg:block">
			<ul class="flex items-center gap-0.5 font-display text-[0.85rem] font-semibold">
				{
					NAV.map((item) => (
						<li>
							<a
								href={item.href}
								class:list={[
									'rounded-full border-2 px-4 py-2 transition',
									path.startsWith(item.href) ? 'border-ink bg-sun' : 'border-transparent hover:border-ink hover:bg-white',
								]}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<details class="group relative lg:hidden">
			<summary
				class="pop flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full bg-sun [&::-webkit-details-marker]:hidden"
				aria-label="Open menu"
			>
				<svg class="group-open:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
				<svg class="hidden group-open:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
			</summary>
			<nav aria-label="Mobile" class="pop-lg absolute right-0 top-14 w-72 rounded-3xl bg-white p-2">
				<ul>
					{
						NAV.map((item) => (
							<li>
								<a href={item.href} class="block rounded-2xl px-4 py-3 font-display text-base font-semibold hover:bg-sun">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</details>
	</div>
</header>
