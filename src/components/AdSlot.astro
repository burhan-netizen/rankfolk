---
// Manual AdSense unit. Renders nothing until SITE.adsenseClient and a slot ID are set.
// Most new sites start with Auto ads (turned on in the AdSense dashboard), which needs no slots.
import { SITE } from '../site.config';

interface Props {
	slot?: string;
	format?: string;
	class?: string;
}
const { slot = '', format = 'auto', class: className = '' } = Astro.props;
const enabled = Boolean(SITE.adsenseClient && slot);
---

{
	enabled && (
		<div class={`my-10 text-center ${className}`}>
			<p class="mb-1 text-[0.7rem] uppercase tracking-widest text-muted">Advertisement</p>
			<ins
				class="adsbygoogle block"
				data-ad-client={SITE.adsenseClient}
				data-ad-slot={slot}
				data-ad-format={format}
				data-full-width-responsive="true"
			/>
			<script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
		</div>
	)
}
