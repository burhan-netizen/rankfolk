---
import { Image } from 'astro:assets';
import { type Post, postUrl, getCategory, formatDate, readingTime } from '../lib/posts';
import { CATEGORY_ICONS } from '../lib/icons';

interface Props {
	post: Post;
	large?: boolean;
}
const { post, large = false } = Astro.props;
const cat = getCategory(post.data.category);
const minutes = readingTime(post.body);
---

<article
	class:list={[
		'group relative flex h-full flex-col overflow-hidden rounded-3xl border border-line bg-white/60 transition hover:-translate-y-0.5 hover:border-forest/40 hover:shadow-lg',
		large && 'md:flex-row',
	]}
>
	<div class:list={['relative shrink-0', large && 'md:w-[42%]']}>
		{
			post.data.heroImage ? (
				<Image
					src={post.data.heroImage}
					alt={post.data.heroAlt ?? ''}
					width={800}
					height={450}
					class:list={['aspect-[16/9] h-full w-full object-cover']}
				/>
			) : (
				<div
					class:list={[
						'relative flex aspect-[2/1] h-full items-center justify-center overflow-hidden bg-gradient-to-br from-mint via-cream to-marigold-soft',
						large && 'md:aspect-auto md:min-h-72',
					]}
				>
					<span class="absolute -bottom-10 -right-10 h-40 w-40 rounded-full bg-white/40" />
					<span class="absolute -left-6 -top-6 h-24 w-24 rounded-full bg-white/30" />
					<span class="relative flex h-16 w-16 items-center justify-center rounded-2xl bg-forest text-white shadow-lg shadow-forest/20 transition group-hover:scale-105">
						<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d={CATEGORY_ICONS[post.data.category]} />
						</svg>
					</span>
				</div>
			)
		}
	</div>
	<div class:list={['flex flex-1 flex-col p-6', large && 'md:p-9']}>
		<span class="pill self-start">{cat?.name}</span>
		<h3 class:list={['mt-3 font-bold text-ink', large ? 'text-2xl md:text-3xl' : 'text-xl']}>
			<a href={postUrl(post)} class="after:absolute after:inset-0">
				{post.data.title}
			</a>
		</h3>
		<p class="mt-2 line-clamp-3 text-ink-soft">{post.data.description}</p>
		<p class="mt-auto pt-5 text-sm text-muted">
			<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
			<span aria-hidden="true"> · </span>
			{minutes} min read
		</p>
	</div>
</article>
