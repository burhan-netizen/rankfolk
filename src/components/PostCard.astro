---
import { Image } from 'astro:assets';
import Cover from './Cover.astro';
import { type Post, postUrl, getCategory, formatDate, readingTime } from '../lib/posts';

interface Props {
	post: Post;
	large?: boolean;
}
const { post, large = false } = Astro.props;
const cat = getCategory(post.data.category);
const minutes = readingTime(post.body);
---

<article
	class:list={[
		'group pop-lg pop-hover relative flex h-full flex-col overflow-hidden rounded-[1.75rem] bg-white',
		large && 'md:flex-row',
	]}
>
	<div class:list={['shrink-0 border-b-2 border-ink', large && 'md:w-[48%] md:border-b-0 md:border-r-2']}>
		{
			post.data.heroImage ? (
				<Image src={post.data.heroImage} alt={post.data.heroAlt ?? ''} width={900} height={560} class="aspect-[16/10] h-full w-full object-cover" />
			) : (
				<Cover
					category={post.data.category}
					text={post.data.coverTitle ?? post.data.title}
					label={cat?.name ?? ''}
					size={large ? 'lg' : 'sm'}
					class:list={['h-full', large ? 'aspect-[16/11] md:aspect-auto md:min-h-[22rem]' : 'aspect-[16/11]']}
				/>
			)
		}
	</div>
	<div class:list={['flex flex-1 flex-col p-6', large && 'md:p-10 md:justify-center']}>
		{post.data.heroImage && <p class="mb-2 text-sm font-semibold text-blue">{cat?.name}</p>}
		<h3 class:list={['font-extrabold text-ink', large ? 'text-2xl md:text-3xl leading-tight' : 'text-[1.15rem] leading-snug']}>
			<a href={postUrl(post)} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-sun group-hover:decoration-4 group-hover:underline-offset-4">
				{post.data.title}
			</a>
		</h3>
		<p class:list={['mt-3 text-ink-soft', large ? 'text-lg line-clamp-4' : 'line-clamp-3']}>{post.data.description}</p>
		<div class="mt-auto flex items-center justify-between gap-3 pt-6 text-sm font-medium text-muted">
			<span>
				<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
				<span aria-hidden="true"> · </span>
				{minutes} min read
			</span>
			<span class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-ink bg-sun text-ink transition group-hover:rotate-[-45deg] group-hover:bg-blue group-hover:text-white" aria-hidden="true">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
			</span>
		</div>
	</div>
</article>
