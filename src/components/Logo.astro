---
interface Props {
	size?: number;
	showText?: boolean;
	invert?: boolean;
	class?: string;
}
const { size = 38, showText = true, invert = false, class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
	<svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
		<rect x="4" y="4" width="42" height="42" rx="13" fill="#0b0f1f"></rect>
		<rect x="1" y="1" width="42" height="42" rx="13" fill="#2b4bff" stroke="#0b0f1f" stroke-width="2"></rect>
		<path d="M14 33V13h9.5a6.25 6.25 0 0 1 0 12.5H14" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
		<path d="M22.5 26l8 7.5" stroke="#fff" stroke-width="5" stroke-linecap="round"></path>
		<circle cx="35.5" cy="10.5" r="4.5" fill="#ffd43b" stroke="#0b0f1f" stroke-width="2"></circle>
	</svg>
	{
		showText && (
			<span class:list={['font-display text-[1.6rem] font-extrabold leading-none tracking-[-0.04em]', invert ? 'text-white' : 'text-ink']}>
				rankfolk
			</span>
		)
	}
</span>
