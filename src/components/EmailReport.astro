---
// "Email me the full report" box used by the tools. Wired up by src/scripts/email-report.ts.
import { SITE } from '../site.config';

interface Props {
	id: string;
	heading: string;
	text: string;
	askBusiness?: boolean;
}
const { id, heading, text, askBusiness = false } = Astro.props;
---

<div id={id} class="pop-lg rounded-[1.75rem] bg-sun p-6 md:p-8" data-sitekey={SITE.turnstileSiteKey}>
	<div data-form-wrap>
		<span class="sticker bg-white">Free full report</span>
		<h3 class="mt-4 text-2xl font-extrabold">{heading}</h3>
		<p class="mt-2 text-ink-soft">{text}</p>
		<form class="mt-5 space-y-4" novalidate>
			{
				askBusiness && (
					<div>
						<label for={`${id}-business`} class="block text-sm font-bold">Business name <span class="font-medium text-ink-soft">(optional)</span></label>
						<input id={`${id}-business`} name="business" type="text" maxlength="80" autocomplete="organization" class="mt-1.5 w-full rounded-xl border-2 border-ink bg-white px-4 py-3 text-base outline-none focus:ring-4 focus:ring-blue/30" />
					</div>
				)
			}
			<div>
				<label for={`${id}-email`} class="block text-sm font-bold">Your email</label>
				<input id={`${id}-email`} name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@yourbusiness.com" class="mt-1.5 w-full rounded-xl border-2 border-ink bg-white px-4 py-3 text-base outline-none focus:ring-4 focus:ring-blue/30" />
			</div>
			<label class="flex cursor-pointer items-start gap-3 text-[0.95rem]">
				<input type="checkbox" name="subscribe" class="mt-1 h-5 w-5 shrink-0 accent-blue" />
				<span>Also send me occasional practical tips to get more customers. Unsubscribe any time.</span>
			</label>
			<div data-turnstile class="min-h-[65px]"></div>
			<button type="submit" class="btn w-full justify-center sm:w-auto">
				Email my full report
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
			</button>
			<p data-status role="status" aria-live="polite" class="text-sm font-semibold"></p>
		</form>
		<p class="mt-4 text-xs text-ink-soft">
			We use your email to send this report (and tips only if you tick the box). See our <a href="/privacy-policy/" class="underline">privacy policy</a>.
		</p>
	</div>
	<div data-done hidden>
		<span class="sticker bg-white">Sent</span>
		<h3 class="mt-4 text-2xl font-extrabold">Check your inbox</h3>
		<p class="mt-2 text-ink-soft">Your full report is on its way from {SITE.email}. If you can't see it in a few minutes, check your spam or promotions folder.</p>
	</div>
</div>
