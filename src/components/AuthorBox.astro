---
import { Image } from 'astro:assets';
import { AUTHOR } from '../site.config';
import photo from '../assets/burhan-kapasi-square.jpg';
---

<aside class="pop-lg mt-12 flex flex-col gap-5 rounded-[1.75rem] bg-white p-6 sm:flex-row sm:p-8" aria-label="About the author">
	<a href="/about/" class="block h-24 w-24 shrink-0 -rotate-3 overflow-hidden rounded-2xl border-2 border-ink shadow-[3px_3px_0_0_#0b0f1f]">
		<Image src={photo} alt={AUTHOR.name} width={192} height={192} class="h-full w-full object-cover" />
	</a>
	<div>
		<p class="font-display text-sm font-bold uppercase tracking-widest text-blue">Written by</p>
		<p class="mt-1 font-display text-xl font-extrabold">
			<a href="/about/" class="hover:text-blue">{AUTHOR.name}</a>
		</p>
		<p class="text-sm font-medium text-muted">{AUTHOR.role}</p>
		<p class="mt-3 text-ink-soft">{AUTHOR.bio}</p>
		<a href={AUTHOR.linkedin} rel="noopener me" target="_blank" class="sticker mt-4 bg-sun hover:bg-blue hover:text-white">
			Connect on LinkedIn ↗
		</a>
	</div>
</aside>
