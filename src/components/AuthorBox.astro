---
import { AUTHOR } from '../site.config';
const initials = AUTHOR.name
	.split(' ')
	.map((p) => p[0])
	.join('')
	.slice(0, 2);
---

<aside class="mt-14 flex flex-col gap-5 rounded-3xl border border-line bg-cream/70 p-6 sm:flex-row sm:p-8" aria-label="About the author">
	<div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-forest font-display text-xl font-bold text-white">
		{initials}
	</div>
	<div>
		<p class="text-sm font-semibold uppercase tracking-wider text-muted">Written by</p>
		<p class="mt-1 font-display text-xl font-bold">
			<a href="/about/" class="hover:text-forest">{AUTHOR.name}</a>
		</p>
		<p class="text-sm text-muted">{AUTHOR.role}</p>
		<p class="mt-3 text-ink-soft">{AUTHOR.bio}</p>
		<a href={AUTHOR.linkedin} rel="noopener me" target="_blank" class="mt-3 inline-block text-sm font-semibold text-forest hover:underline">
			Connect on LinkedIn
		</a>
	</div>
</aside>
