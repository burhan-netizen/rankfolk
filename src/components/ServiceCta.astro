---
import { SERVICE_CTA, SITE } from '../site.config';
---

{
	SITE.showServiceCta && (
		<aside class="pop-lg relative mt-14 overflow-hidden rounded-[1.75rem] bg-sun p-7 sm:p-9" aria-label="Get help">
			<svg class="absolute -right-8 -top-8 h-40 w-40 text-white/50" viewBox="0 0 100 100" aria-hidden="true">
				<path d="M50 0l12 38 38 12-38 12-12 38-12-38L0 50l38-12z" fill="currentColor" />
			</svg>
			<p class="relative font-display text-3xl font-extrabold">{SERVICE_CTA.title}</p>
			<p class="relative mt-2 max-w-xl text-ink-soft">{SERVICE_CTA.text}</p>
			<a href={SERVICE_CTA.url} target="_blank" rel="noopener" class="btn relative mt-6">
				{SERVICE_CTA.label}
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
			</a>
		</aside>
	)
}
