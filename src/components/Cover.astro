---
// Auto-generated article cover: bold color block, short title and a category icon sticker.
import { CATEGORY_ICONS, CATEGORY_THEME } from '../lib/icons';

interface Props {
	category: string;
	text: string;
	label: string;
	size?: 'sm' | 'lg';
	class?: string;
}
const { category, text, label, size = 'sm', class: className = '' } = Astro.props;
const theme = CATEGORY_THEME[category] ?? CATEGORY_THEME.websites;
---

<div class:list={['relative isolate overflow-hidden', theme.bg, theme.fg, className]}>
	<!-- decorative shapes -->
	<svg class="absolute -right-10 -top-10 -z-10 h-48 w-48 opacity-25" viewBox="0 0 100 100" aria-hidden="true">
		<circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="8" stroke-dasharray="14 10"></circle>
	</svg>
	<svg class="absolute -bottom-6 left-1/2 -z-10 h-24 w-24 opacity-20" viewBox="0 0 100 100" aria-hidden="true">
		<path d="M50 0l12 38 38 12-38 12-12 38-12-38L0 50l38-12z" fill="currentColor"></path>
	</svg>

	<div class:list={['flex h-full flex-col justify-between', size === 'lg' ? 'gap-8 p-7 md:p-10' : 'gap-6 p-6']}>
		<div class="flex items-start justify-between gap-4">
			<span class="sticker !border-ink !bg-white !text-ink">{label}</span>
			<span
				class:list={[
					'flex shrink-0 items-center justify-center rounded-2xl border-2 border-ink text-ink shadow-[3px_3px_0_0_#0b0f1f]',
					theme.chip,
					theme.chip === 'bg-blue' && '!text-white',
					size === 'lg' ? 'h-16 w-16 rotate-6' : 'h-12 w-12 rotate-6',
				]}
			>
				<svg width={size === 'lg' ? 30 : 24} height={size === 'lg' ? 30 : 24} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d={CATEGORY_ICONS[category]}></path>
				</svg>
			</span>
		</div>
		<p
			class:list={[
				'font-display font-extrabold leading-[1.08] tracking-[-0.015em]',
				size === 'lg' ? 'text-3xl md:text-[2.5rem]' : 'text-[1.4rem]',
			]}
			aria-hidden="true"
		>
			{text}
		</p>
	</div>
</div>
