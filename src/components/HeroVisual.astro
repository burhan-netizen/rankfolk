---
// Decorative illustration of a Google Maps style local result with "Your business" at the top.
const listings = [
	{ name: 'Your Business', rating: '4.9', reviews: '127', top: true },
	{ name: 'Competitor A', rating: '4.3', reviews: '58', top: false },
	{ name: 'Competitor B', rating: '4.1', reviews: '31', top: false },
];
---

<div class="relative mx-auto w-full max-w-[30rem]" aria-hidden="true">
	<!-- back card -->
	<div class="absolute inset-0 translate-x-4 translate-y-4 rotate-3 rounded-[2rem] border-2 border-ink bg-sun"></div>

	<!-- main card -->
	<div class="pop-lg relative overflow-hidden rounded-[2rem] bg-white">
		<!-- search bar -->
		<div class="flex items-center gap-3 border-b-2 border-ink p-4">
			<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-tint text-blue">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-5-5"></path></svg>
			</span>
			<span class="flex-1 rounded-full border-2 border-ink/15 px-4 py-2 font-medium text-ink-soft">plumber near me</span>
		</div>

		<!-- map -->
		<div class="dots relative h-36 border-b-2 border-ink bg-blue-tint">
			<svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 144" preserveAspectRatio="none">
				<path d="M-10 100 C 80 70, 140 130, 230 90 S 360 40, 420 70" fill="none" stroke="#fff" stroke-width="14"></path>
				<path d="M120 -10 C 140 50, 110 90, 160 160" fill="none" stroke="#fff" stroke-width="10"></path>
			</svg>
			<span class="absolute left-[18%] top-[45%] h-4 w-4 rounded-full border-2 border-ink bg-white"></span>
			<span class="absolute left-[72%] top-[30%] h-4 w-4 rounded-full border-2 border-ink bg-white"></span>
			<span class="absolute left-[46%] top-[14%] flex flex-col items-center">
				<span class="flex h-11 w-11 items-center justify-center rounded-full rounded-br-none border-2 border-ink bg-coral font-display text-lg font-extrabold shadow-[3px_3px_0_0_#0b0f1f] [transform:rotate(45deg)]">
					<span class="[transform:rotate(-45deg)]">1</span>
				</span>
			</span>
		</div>

		<!-- listings -->
		<ul class="divide-y-2 divide-ink/10">
			{
				listings.map((l, i) => (
					<li class:list={['flex items-center gap-3 px-4 py-3.5', l.top && 'bg-sun-soft']}>
						<span
							class:list={[
								'flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-ink font-display text-sm font-extrabold',
								l.top ? 'bg-blue text-white' : 'bg-white',
							]}
						>
							{i + 1}
						</span>
						<span class="min-w-0 flex-1">
							<span class:list={['block truncate font-display font-bold', l.top ? 'text-lg' : 'text-ink-soft']}>{l.name}</span>
							<span class="flex items-center gap-1 text-sm text-muted">
								<span class="font-semibold text-ink">{l.rating}</span>
								<span class="tracking-tight text-[#f5a400]">★★★★★</span>
								<span>({l.reviews})</span>
							</span>
						</span>
						{l.top && (
							<span class="flex items-center gap-1.5 rounded-full border-2 border-ink bg-blue px-3.5 py-1.5 font-display text-sm font-bold text-white">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
								Call
							</span>
						)}
					</li>
				))
			}
		</ul>
	</div>

	<!-- floating stickers -->
	<span class="floaty sticker absolute -left-4 top-24 bg-sun shadow-[3px_3px_0_0_#0b0f1f] sm:-left-10" style="--r:-8deg">
		#1 on Google Maps
	</span>
	<span class="floaty sticker absolute -right-3 -top-5 bg-mint shadow-[3px_3px_0_0_#0b0f1f] sm:-right-8" style="--r:6deg; animation-delay:-2s">
		More calls ↗
	</span>
	<span class="floaty sticker absolute -bottom-6 left-10 bg-lilac shadow-[3px_3px_0_0_#0b0f1f]" style="--r:-3deg; animation-delay:-3.5s">
		★ Real reviews
	</span>
</div>
