---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	eyebrow?: string;
	updated?: string;
	noindex?: boolean;
}
const { title, description, eyebrow, updated, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
	<section class="border-b border-line bg-cream/50">
		<div class="container-read py-14 md:py-20">
			{eyebrow && <span class="pill">{eyebrow}</span>}
			<h1 class="mt-4 text-4xl font-bold md:text-5xl">{title}</h1>
			<p class="mt-4 text-lg text-ink-soft">{description}</p>
			{updated && <p class="mt-3 text-sm text-muted">Last updated: {updated}</p>}
		</div>
	</section>
	<div class="container-read py-12">
		<div class="prose prose-lg prose-rankfolk max-w-none">
			<slot />
		</div>
	</div>
</BaseLayout>
