---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	eyebrow?: string;
	updated?: string;
	noindex?: boolean;
}
const { title, description, eyebrow, updated, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
	<section class="dots border-b-2 border-ink">
		<div class="container-read py-14 md:py-20">
			{eyebrow && <span class="sticker -rotate-2 bg-sun">{eyebrow}</span>}
			<h1 class="mt-5 text-4xl font-extrabold md:text-5xl">{title}</h1>
			<p class="mt-5 text-lg text-ink-soft md:text-xl">{description}</p>
			{updated && <p class="mt-4 text-sm font-medium text-muted">Last updated: {updated}</p>}
		</div>
	</section>
	<div class="container-read py-12">
		<div class="prose prose-lg prose-rankfolk max-w-none">
			<slot />
		</div>
	</div>
</BaseLayout>
