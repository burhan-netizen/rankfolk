---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { SITE, AUTHOR, CATEGORIES } from '../site.config';
import { CATEGORY_ICONS as icons } from '../lib/icons';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const latest = posts.filter((p) => p.id !== featured?.id).slice(0, 6);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.slug, posts.filter((p) => p.data.category === c.slug).length]));


const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE.name,
		url: SITE.url,
		description: SITE.description,
		publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: `${SITE.url}/favicon.svg` },
	},
];
---

<BaseLayout title={SITE.name} description={SITE.description} schema={schema}>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-mint blur-3xl"></div>
		<div class="pointer-events-none absolute -left-20 top-40 h-72 w-72 rounded-full bg-marigold-soft blur-3xl"></div>
		<div class="container-wide relative py-16 md:py-24">
			<span class="pill">For small business owners and contractors</span>
			<h1 class="mt-5 max-w-4xl text-[2.6rem] font-extrabold leading-[1.05] md:text-7xl">
				Helping small businesses get <span class="highlight">more customers</span> online
			</h1>
			<p class="mt-6 max-w-2xl text-lg text-ink-soft md:text-xl">
				Simple, practical guides on websites, Google rankings and Google Maps. No jargon, no fluff, just what brings in calls.
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href="/blog/" class="btn">
					Read the guides
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</a>
				<a href="/category/google-business-profile/" class="btn btn-ghost">Get found on Google Maps</a>
			</div>
		</div>
	</section>

	<!-- Featured -->
	{
		featured && (
			<section class="container-wide">
				<h2 class="mb-6 text-sm font-bold uppercase tracking-wider text-muted">Start here</h2>
				<PostCard post={featured} large />
			</section>
		)
	}

	<!-- Topics -->
	<section class="container-wide mt-20">
		<div class="flex items-end justify-between gap-4">
			<h2 class="text-3xl font-bold md:text-4xl">Browse by topic</h2>
		</div>
		<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
			{
				CATEGORIES.map((c) => (
					<a
						href={`/category/${c.slug}/`}
						class="group rounded-3xl border border-line bg-white/60 p-6 transition hover:-translate-y-0.5 hover:border-forest/40 hover:shadow-md"
					>
						<span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-mint text-forest-dark">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d={icons[c.slug]} />
							</svg>
						</span>
						<h3 class="mt-4 text-lg font-bold group-hover:text-forest">{c.name}</h3>
						<p class="mt-1 text-sm text-ink-soft">{c.description}</p>
						<p class="mt-3 text-xs font-semibold text-muted">
							{counts[c.slug] === 0 ? 'Coming soon' : `${counts[c.slug]} ${counts[c.slug] === 1 ? 'guide' : 'guides'}`}
						</p>
					</a>
				))
			}
		</div>
	</section>

	<!-- Latest -->
	{
		latest.length > 0 && (
			<section class="container-wide mt-20">
				<div class="flex items-end justify-between gap-4">
					<h2 class="text-3xl font-bold md:text-4xl">Latest guides</h2>
					<a href="/blog/" class="font-semibold text-forest hover:underline">
						See all
					</a>
				</div>
				<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{latest.map((post) => <PostCard post={post} />)}
				</div>
			</section>
		)
	}

	<!-- About strip -->
	<section class="container-wide mt-20">
		<div class="grid items-center gap-8 rounded-[2rem] bg-ink p-8 text-white md:grid-cols-[1fr_auto] md:p-12">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wider text-marigold">Who writes Rankfolk</p>
				<h2 class="mt-3 text-3xl font-bold md:text-4xl">Advice from someone who does this work every day</h2>
				<p class="mt-4 max-w-2xl text-white/80">
					{AUTHOR.name} builds websites and runs local SEO for small businesses and contractors. Every guide here comes from real client work, not theory.
				</p>
			</div>
			<a href="/about/" class="btn self-start bg-marigold text-ink hover:bg-white md:self-center">About Rankfolk</a>
		</div>
	</section>
</BaseLayout>
