---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page could not be found." noindex>
	<section class="container-read py-24 text-center">
		<p class="font-display text-7xl font-extrabold text-forest">404</p>
		<h1 class="mt-4 text-3xl font-bold">This page got lost</h1>
		<p class="mt-3 text-ink-soft">It may have moved, or the link may be wrong.</p>
		<div class="mt-8 flex justify-center gap-3">
			<a href="/" class="btn">Go home</a>
			<a href="/blog/" class="btn btn-ghost">Browse guides</a>
		</div>
	</section>
</BaseLayout>
