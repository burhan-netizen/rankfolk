---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import ServiceCta from '../../components/ServiceCta.astro';
import AdSlot from '../../components/AdSlot.astro';
import PostCard from '../../components/PostCard.astro';
import Cover from '../../components/Cover.astro';
import { getPosts, getCategory, formatDate, readingTime, relatedPosts, postUrl } from '../../lib/posts';
import { SITE, AUTHOR } from '../../site.config';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, heroImage, heroAlt, coverTitle } = post.data;
const cat = getCategory(post.data.category)!;
const minutes = readingTime(post.body);
const toc = headings.filter((h) => h.depth === 2);
const related = relatedPosts(all, post);
const url = `${SITE.url}${postUrl(post)}`;

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: title,
		description,
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate ?? pubDate).toISOString(),
		mainEntityOfPage: url,
		author: { '@type': 'Person', name: AUTHOR.name, url: `${SITE.url}/about/`, sameAs: [AUTHOR.linkedin] },
		publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` } },
		...(heroImage ? { image: new URL(heroImage.src, SITE.url).href } : {}),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
			{ '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE.url}/category/${cat.slug}/` },
			{ '@type': 'ListItem', position: 3, name: title, item: url },
		],
	},
];
---

<BaseLayout
	title={title}
	description={description}
	type="article"
	image={heroImage?.src}
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	schema={schema}
>
	<article>
		<header class="dots border-b-2 border-ink">
			<div class="container-wide grid items-center gap-10 py-12 md:py-16 lg:grid-cols-[1.25fr_1fr]">
				<div>
					<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm font-semibold">
						<a href="/" class="text-muted hover:text-blue">Home</a>
						<span aria-hidden="true" class="text-muted">/</span>
						<a href={`/category/${cat.slug}/`} class="sticker !py-1.5 bg-sun hover:bg-white">{cat.name}</a>
					</nav>
					<h1 class="mt-6 text-[1.75rem] font-extrabold leading-[1.1] md:text-[2.6rem]">{title}</h1>
					<p class="mt-5 text-lg text-ink-soft md:text-xl">{description}</p>
					<div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm font-medium text-muted">
						<a href="/about/" class="flex items-center gap-2.5 font-bold text-ink hover:text-blue">
							<span class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-ink bg-blue font-display text-sm font-extrabold text-white">BK</span>
							{AUTHOR.name}
						</a>
						<span>
							{updatedDate ? 'Updated ' : 'Published '}
							<time datetime={(updatedDate ?? pubDate).toISOString()}>{formatDate(updatedDate ?? pubDate)}</time>
						</span>
						<span class="sticker !py-1 !text-xs bg-white">{minutes} min read</span>
					</div>
				</div>
				<div class="hidden lg:block">
					{
						heroImage ? (
							<Image src={heroImage} alt={heroAlt ?? ''} width={900} height={620} class="pop-lg w-full rounded-[1.75rem]" loading="eager" />
						) : (
							<div class="pop-lg rotate-2 overflow-hidden rounded-[1.75rem]">
								<Cover category={post.data.category} text={coverTitle ?? title} label={cat.name} size="lg" class="aspect-[4/3]" />
							</div>
						)
					}
				</div>
			</div>
		</header>

		<div class="container-read mt-12">
			{
				toc.length > 2 && (
					<nav aria-label="In this guide" class="pop mb-12 rounded-3xl bg-blue-tint p-6 md:p-7">
						<p class="font-display text-lg font-extrabold">In this guide</p>
						<ol class="mt-4 space-y-2.5">
							{toc.map((h, i) => (
								<li class="flex gap-3">
									<span class="flex h-6 w-7 shrink-0 items-center justify-center rounded-md bg-blue font-display text-xs font-bold text-white">{i + 1}</span>
									<a href={`#${h.slug}`} class="font-medium text-ink-soft hover:text-blue hover:underline">
										{h.text}
									</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}

			<AdSlot slot="" />

			<div class="prose prose-lg prose-rankfolk max-w-none">
				<Content />
			</div>

			<AdSlot slot="" />

			<ServiceCta />
			<AuthorBox />
		</div>
	</article>

	{
		related.length > 0 && (
			<section class="container-wide mt-24">
				<h2 class="text-3xl font-extrabold">Keep reading</h2>
				<div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
					{related.map((p) => <PostCard post={p} />)}
				</div>
			</section>
		)
	}
</BaseLayout>
