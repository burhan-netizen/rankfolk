---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import ServiceCta from '../../components/ServiceCta.astro';
import AdSlot from '../../components/AdSlot.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, getCategory, formatDate, readingTime, relatedPosts, postUrl } from '../../lib/posts';
import { SITE, AUTHOR } from '../../site.config';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, heroImage, heroAlt } = post.data;
const cat = getCategory(post.data.category)!;
const minutes = readingTime(post.body);
const toc = headings.filter((h) => h.depth === 2);
const related = relatedPosts(all, post);
const url = `${SITE.url}${postUrl(post)}`;

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: title,
		description,
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate ?? pubDate).toISOString(),
		mainEntityOfPage: url,
		author: { '@type': 'Person', name: AUTHOR.name, url: `${SITE.url}/about/`, sameAs: [AUTHOR.linkedin] },
		publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` } },
		...(heroImage ? { image: new URL(heroImage.src, SITE.url).href } : {}),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
			{ '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE.url}/category/${cat.slug}/` },
			{ '@type': 'ListItem', position: 3, name: title, item: url },
		],
	},
];
---

<BaseLayout
	title={title}
	description={description}
	type="article"
	image={heroImage?.src}
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	schema={schema}
>
	<article>
		<header class="border-b border-line bg-cream/50">
			<div class="container-read py-12 md:py-16">
				<nav aria-label="Breadcrumb" class="text-sm text-muted">
					<a href="/" class="hover:text-forest">Home</a>
					<span aria-hidden="true"> / </span>
					<a href={`/category/${cat.slug}/`} class="hover:text-forest">{cat.name}</a>
				</nav>
				<h1 class="mt-5 text-[2.1rem] font-extrabold leading-[1.1] md:text-5xl">{title}</h1>
				<p class="mt-5 text-lg text-ink-soft md:text-xl">{description}</p>
				<div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
					<a href="/about/" class="flex items-center gap-2 font-semibold text-ink hover:text-forest">
						<span class="flex h-8 w-8 items-center justify-center rounded-full bg-forest text-xs font-bold text-white">BK</span>
						{AUTHOR.name}
					</a>
					<span>
						{updatedDate ? 'Updated ' : 'Published '}
						<time datetime={(updatedDate ?? pubDate).toISOString()}>{formatDate(updatedDate ?? pubDate)}</time>
					</span>
					<span>{minutes} min read</span>
				</div>
			</div>
		</header>

		{
			heroImage && (
				<div class="container-wide mt-10">
					<Image src={heroImage} alt={heroAlt ?? ''} width={1200} height={630} class="mx-auto w-full max-w-4xl rounded-3xl" loading="eager" />
				</div>
			)
		}

		<div class="container-read mt-10">
			{
				toc.length > 2 && (
					<nav aria-label="In this guide" class="mb-10 rounded-3xl border border-line bg-white/60 p-6">
						<p class="font-display text-lg font-bold">In this guide</p>
						<ol class="mt-3 space-y-2 text-ink-soft">
							{toc.map((h, i) => (
								<li class="flex gap-3">
									<span class="w-6 shrink-0 font-semibold text-forest">{i + 1}.</span>
									<a href={`#${h.slug}`} class="hover:text-forest hover:underline">
										{h.text}
									</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}

			<AdSlot slot="" />

			<div class="prose prose-lg prose-rankfolk max-w-none">
				<Content />
			</div>

			<AdSlot slot="" />

			<ServiceCta />
			<AuthorBox />
		</div>
	</article>

	{
		related.length > 0 && (
			<section class="container-wide mt-20">
				<h2 class="text-3xl font-bold">Keep reading</h2>
				<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{related.map((p) => <PostCard post={p} />)}
				</div>
			</section>
		)
	}
</BaseLayout>
