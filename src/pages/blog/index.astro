---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { CATEGORIES } from '../../site.config';
import { CATEGORY_THEME } from '../../lib/icons';

const posts = await getPosts();
---

<BaseLayout
	title="All guides"
	description="Every Rankfolk guide on websites, SEO, Google Business Profile and marketing for small businesses."
>
	<section class="dots border-b-2 border-ink">
		<div class="container-wide py-14 md:py-20">
			<span class="sticker -rotate-2 bg-sun">{posts.length} guides and counting</span>
			<h1 class="mt-5 text-4xl font-extrabold md:text-6xl">
				All <span class="marker">guides</span>
			</h1>
			<p class="mt-5 max-w-2xl text-lg text-ink-soft md:text-xl">Practical, step-by-step help for getting more customers online.</p>
			<div class="mt-9 flex flex-wrap gap-3">
				{
					CATEGORIES.map((c) => (
						<a href={`/category/${c.slug}/`} class:list={['sticker pop-hover shadow-[3px_3px_0_0_#0b0f1f]', CATEGORY_THEME[c.slug].bg, CATEGORY_THEME[c.slug].fg]}>
							{c.name}
						</a>
					))
				}
			</div>
		</div>
	</section>
	<section class="container-wide mt-14">
		<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</section>
</BaseLayout>
