---
import ToolLayout from '../../layouts/ToolLayout.astro';

const field = 'mt-1.5 w-full rounded-xl border-2 border-ink bg-white px-4 py-3 text-base outline-none focus:ring-4 focus:ring-blue/30';
const outputs = [
	{ id: 'sms', label: 'Text message', note: 'Send right after the job, while they are happiest.' },
	{ id: 'email', label: 'Email', note: 'Good for appointment-based and online businesses.' },
	{ id: 'whatsapp', label: 'WhatsApp', note: 'Opens WhatsApp with the message ready to send.' },
	{ id: 'person', label: 'Say it in person', note: 'Use at the final walk-through or at checkout.' },
	{ id: 'reminder', label: 'One gentle reminder', note: 'Optional. Send once, a few days later, then leave it.' },
];
---

<ToolLayout
	slug="review-request-generator"
	title="Review Request Generator"
	seoTitle="Free Google Review Request Generator (Text, Email and QR Code)"
	eyebrow="Free tool"
	description="Free Google review request generator: ready-to-send text, email and WhatsApp messages that follow Google's rules, plus a printable review QR code card."
	intro="Fill in a few details and get ready-to-send review requests for text, email and WhatsApp, plus a printable QR code card. Nothing you type leaves your browser."
>
	<div class="grid gap-10 lg:grid-cols-[24rem_1fr]">
		<!-- Inputs -->
		<div>
			<form id="rr-form" class="pop-lg space-y-5 rounded-[2rem] bg-white p-6 md:p-7 lg:sticky lg:top-[5.75rem]" novalidate autocomplete="off">
				<div>
					<label for="rr-business" class="block text-sm font-bold">Business name</label>
					<input id="rr-business" name="business" type="text" maxlength="80" placeholder="Northside Decks" class={field} />
				</div>
				<div>
					<label for="rr-link" class="block text-sm font-bold">Your Google review link</label>
					<input id="rr-link" name="link" type="url" inputmode="url" placeholder="https://g.page/r/..." class={field} />
					<p id="rr-link-note" class="mt-1.5 text-sm text-ink-soft">
						Find it at business.google.com: select <strong>Read reviews</strong>, then <strong>Get more reviews</strong>, and copy the link.
					</p>
				</div>
				<div class="grid grid-cols-2 gap-3">
					<div>
						<label for="rr-customer" class="block text-sm font-bold">Customer <span class="font-medium text-ink-soft">(optional)</span></label>
						<input id="rr-customer" name="customer" type="text" maxlength="40" placeholder="Sarah" class={field} />
					</div>
					<div>
						<label for="rr-you" class="block text-sm font-bold">Your name <span class="font-medium text-ink-soft">(optional)</span></label>
						<input id="rr-you" name="you" type="text" maxlength="40" placeholder="Mike" class={field} />
					</div>
				</div>
				<div>
					<label for="rr-job" class="block text-sm font-bold">The job or service <span class="font-medium text-ink-soft">(optional)</span></label>
					<input id="rr-job" name="job" type="text" maxlength="60" placeholder="new deck" class={field} />
				</div>
				<fieldset>
					<legend class="text-sm font-bold">Tone</legend>
					<div class="mt-2 grid grid-cols-2 gap-2">
						{
							[
								['friendly', 'Friendly'],
								['professional', 'Professional'],
							].map(([v, l], i) => (
								<label class="cursor-pointer">
									<input type="radio" name="tone" value={v} checked={i === 0} class="peer sr-only" />
									<span class="block rounded-full border-2 border-ink bg-paper px-3 py-2 text-center font-display text-sm font-bold peer-checked:bg-sun peer-checked:shadow-[3px_3px_0_0_#0b0f1f] peer-focus-visible:ring-4 peer-focus-visible:ring-blue/40">{l}</span>
								</label>
							))
						}
					</div>
				</fieldset>
				<p class="rounded-2xl bg-blue-tint p-4 text-sm">
					<strong>Google's rules:</strong> ask every customer, not just happy ones, and never offer discounts or gifts for reviews. These messages are written to follow that.
				</p>
			</form>
		</div>

		<!-- Outputs -->
		<div class="space-y-6">
			{
				outputs.map((o) => (
					<section class="pop-lg rounded-[1.75rem] bg-white p-6" aria-labelledby={`rr-h-${o.id}`}>
						<div class="flex flex-wrap items-start justify-between gap-3">
							<div>
								<h2 id={`rr-h-${o.id}`} class="text-xl font-extrabold">{o.label}</h2>
								<p class="mt-1 text-sm text-ink-soft">{o.note}</p>
							</div>
							<div class="flex gap-2">
								{o.id === 'whatsapp' && (
									<a id="rr-wa" href="#" target="_blank" rel="noopener" class="btn btn-sun !px-4 !py-2 !text-sm">Open WhatsApp</a>
								)}
								<button type="button" class="btn btn-light !px-4 !py-2 !text-sm" data-copy={o.id}>Copy</button>
							</div>
						</div>
						{o.id === 'email' && <p class="mt-4 rounded-xl bg-paper px-4 py-2 text-[0.95rem]"><strong>Subject:</strong> <span id="rr-subject"></span></p>}
						<pre id={`rr-out-${o.id}`} class="mt-4 whitespace-pre-wrap break-words rounded-xl border-2 border-ink/15 bg-paper p-4 font-sans text-[0.98rem] leading-relaxed"></pre>
					</section>
				))
			}

			<!-- QR -->
			<section class="pop-lg rounded-[1.75rem] bg-sun p-6 md:p-8" aria-labelledby="rr-h-qr">
				<h2 id="rr-h-qr" class="text-2xl font-extrabold">Review QR code</h2>
				<p class="mt-1 text-ink-soft">Print it for your counter, invoices, business cards or the back of a quote. Customers scan it and land on your review box.</p>
				<div class="mt-6 grid items-center gap-6 sm:grid-cols-[auto_1fr]">
					<div class="mx-auto rounded-2xl border-2 border-ink bg-white p-3">
						<canvas id="rr-qr" width="220" height="220" class="h-[220px] w-[220px]" aria-label="QR code for your review link"></canvas>
					</div>
					<div class="space-y-3">
						<p id="rr-qr-empty" class="font-semibold">Add your review link to create your QR code.</p>
						<div id="rr-qr-actions" class="flex flex-col gap-3" hidden>
							<button type="button" id="rr-card" class="btn justify-center">Download printable card (PNG)</button>
							<button type="button" id="rr-png" class="btn btn-light justify-center">Download QR code (PNG)</button>
							<button type="button" id="rr-svg" class="btn btn-light justify-center">Download QR code (SVG, for printers)</button>
						</div>
						<p class="text-sm text-ink-soft">Always scan the code with your own phone before printing.</p>
					</div>
				</div>
			</section>
		</div>
	</div>

	<section slot="after" class="container-read pb-6">
		<div class="prose prose-lg prose-rankfolk max-w-none">
			<h2>How to get more Google reviews with these messages</h2>
			<p>
				Timing matters more than wording. Send the message when the customer has just seen the result: the final walk-through, checkout, or the
				evening after the job. The longer you wait, the less likely people are to do it.
			</p>
			<ul>
				<li><strong>Ask everyone.</strong> Google's policies don't allow asking only the customers you expect to be happy.</li>
				<li><strong>Never offer anything in return.</strong> Discounts, gifts or entries into a prize draw for reviews break Google's rules.</li>
				<li><strong>Don't ask for five stars</strong> or tell people what to write. Ask for an honest review.</li>
				<li><strong>Reply to every review</strong>, good or bad. Future customers read your replies.</li>
			</ul>
			<p>
				Google's full rules are in its <a href="https://support.google.com/contributionpolicy/answer/7400114" target="_blank" rel="noopener">prohibited and restricted content policy</a>, and Google explains how to <a href="https://support.google.com/business/answer/16816815" target="_blank" rel="noopener">create a review link or QR code</a> from your Business Profile.
			</p>
			<h2>Frequently asked questions</h2>
			<h3>Where do I find my Google review link?</h3>
			<p>On a computer, go to your Business Profile at business.google.com, select Read reviews, then Get more reviews, and copy the link. Google also gives you a QR code there.</p>
			<h3>Is anything I type saved or sent anywhere?</h3>
			<p>No. The messages and QR code are created in your browser. Nothing you type is sent to Rankfolk.</p>
			<h3>Is it OK to send a reminder?</h3>
			<p>One polite reminder a few days later is fine for most customers. Don't keep chasing people who haven't left one.</p>
			<h3>What if I get a negative review?</h3>
			<p>Reply calmly, apologize where it's fair and offer to sort it out offline. Our guide on <a href="/blog/how-to-respond-to-negative-google-reviews/">responding to negative Google reviews</a> has examples, and <a href="/blog/how-to-get-more-google-reviews/">how to get more Google reviews</a> covers the full routine.</p>
		</div>
	</section>
</ToolLayout>

<script>
	import QRCode from 'qrcode';
	import { track } from '../../scripts/analytics';

	const form = document.getElementById('rr-form') as HTMLFormElement;
	const qrCanvas = document.getElementById('rr-qr') as HTMLCanvasElement;
	const PLACEHOLDER = '[your review link]';
	let current: Record<string, string> = {};

	function vals() {
		const d = new FormData(form);
		const g = (k: string) => String(d.get(k) || '').trim();
		return { business: g('business'), link: g('link'), customer: g('customer'), you: g('you'), job: g('job'), tone: g('tone') || 'friendly' };
	}

	function build(v: ReturnType<typeof vals>) {
		const biz = v.business || 'us';
		const bizName = v.business || 'our business';
		const link = v.link || PLACEHOLDER;
		const hi = v.customer ? `Hi ${v.customer}` : 'Hi there';
		const hello = v.customer ? `Hello ${v.customer}` : 'Hello';
		const forJob = v.job ? ` for your ${v.job}` : '';
		const sign = v.you ? `${v.you}${v.business ? `, ${v.business}` : ''}` : v.business || '';
		const signLine = sign ? `\n${sign}` : '';

		if (v.tone === 'professional') {
			return {
				sms: `${hello}, thank you for choosing ${bizName}${forJob}. We would appreciate your honest feedback in a short Google review: ${link}\nKind regards,${signLine || '\nThe team'}`,
				subject: `How did we do? A quick request from ${bizName}`,
				email: `${hello},\n\nThank you for choosing ${bizName}${forJob}. We hope you are happy with the result.\n\nYour honest feedback helps us improve and helps other people in the area decide who to trust. If you have a minute, we would appreciate a short review on Google:\n\n${link}\n\nThank you for your time.\n\nKind regards,${signLine || '\nThe team'}`,
				whatsapp: `${hello}, thank you for choosing ${bizName}${forJob}. If you have a moment, we would appreciate your honest feedback in a short Google review: ${link}\nThank you.${signLine}`,
				person: `"Thank you for choosing us. Reviews from customers make a real difference to a local business like ours, and we'd appreciate your honest feedback on Google. I'll send you the link by text so it only takes a minute."`,
				reminder: `${hello}, just a gentle follow-up in case our last message got buried. If you have a minute, your honest Google review would be appreciated: ${link}\nThank you either way.${signLine}`,
			};
		}
		return {
			sms: `${hi}, thanks again for choosing ${biz}${forJob}! If you have a minute, a quick Google review really helps a small local business like ours: ${link}\nThank you!${signLine}`,
			subject: `Thanks from ${bizName}`,
			email: `${hi},\n\nThanks so much for choosing ${biz}${forJob}. It was great working with you.\n\nIf you have a moment, we'd really appreciate a review on Google. It helps other people nearby find us, and we read every single one:\n\n${link}\n\nThanks again,${signLine || '\nThe team'}`,
			whatsapp: `${hi}, thanks again for choosing ${biz}${forJob}! If you have a minute, a quick Google review would mean a lot to us: ${link}\nThank you!${signLine}`,
			person: `"We're a small local business and Google reviews make a huge difference for us. Would you mind leaving one? I'll text you the link so it only takes a minute."`,
			reminder: `${hi}, just a quick nudge in case you missed my last message. If you get a minute, an honest Google review would really help us out: ${link}\nNo worries if not, and thanks again!${signLine}`,
		};
	}

	function isLikelyReviewLink(link: string) {
		try {
			const u = new URL(link);
			return u.protocol === 'https:' && /(^|\.)(g\.page|google\.[a-z.]+|goo\.gl|maps\.app\.goo\.gl|g\.co)$/i.test(u.hostname);
		} catch {
			return false;
		}
	}

	async function update() {
		const v = vals();
		current = build(v);
		for (const k of ['sms', 'email', 'whatsapp', 'person', 'reminder']) {
			document.getElementById(`rr-out-${k}`)!.textContent = current[k];
		}
		document.getElementById('rr-subject')!.textContent = current.subject;
		(document.getElementById('rr-wa') as HTMLAnchorElement).href = `https://wa.me/?text=${encodeURIComponent(current.whatsapp)}`;

		const note = document.getElementById('rr-link-note')!;
		const validUrl = /^https:\/\/\S+\.\S+/.test(v.link);
		if (v.link && !validUrl) {
			note.innerHTML = '<span class="font-semibold text-[#a3260b]">That doesn\'t look like a full link. It should start with https://</span>';
		} else if (v.link && !isLikelyReviewLink(v.link)) {
			note.innerHTML = '<span class="font-semibold text-[#7a5a00]">This doesn\'t look like a Google link. Double-check it opens your Google review box.</span>';
		} else if (v.link) {
			note.innerHTML = '<span class="font-semibold text-[#0d8a47]">Looks good. Test it once on your phone.</span>';
		} else {
			note.innerHTML = 'Find it at business.google.com: select <strong>Read reviews</strong>, then <strong>Get more reviews</strong>, and copy the link.';
		}

		const hasLink = validUrl;
		document.getElementById('rr-qr-empty')!.hidden = hasLink;
		document.getElementById('rr-qr-actions')!.hidden = !hasLink;
		const ctx = qrCanvas.getContext('2d')!;
		if (hasLink) {
			await QRCode.toCanvas(qrCanvas, v.link, { width: 220, margin: 1, errorCorrectionLevel: 'M', color: { dark: '#0b0f1f', light: '#ffffff' } });
			qrCanvas.style.width = qrCanvas.style.height = '220px';
		} else {
			ctx.clearRect(0, 0, qrCanvas.width, qrCanvas.height);
			ctx.fillStyle = '#eef1ff';
			ctx.fillRect(0, 0, qrCanvas.width, qrCanvas.height);
		}
	}

	document.getElementById('rr-wa')!.addEventListener('click', () => track('review_whatsapp_open'));
	form.addEventListener('input', update);
	form.addEventListener('change', update);
	update();

	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const k = btn.dataset.copy!;
			const text = k === 'email' ? `Subject: ${current.subject}\n\n${current.email}` : k === 'person' ? current.person.replace(/^"|"$/g, '') : current[k];
			try {
				await navigator.clipboard.writeText(text);
				btn.textContent = 'Copied';
				track('review_message_copied', { channel: k, tone: vals().tone });
			} catch {
				btn.textContent = 'Select and copy';
			}
			setTimeout(() => (btn.textContent = 'Copy'), 1800);
		});
	});

	function download(name: string, url: string) {
		const a = document.createElement('a');
		a.href = url;
		a.download = name;
		document.body.appendChild(a);
		a.click();
		a.remove();
	}

	const slug = () => (vals().business || 'google-review').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'google-review';

	document.getElementById('rr-png')!.addEventListener('click', async () => {
		const url = await QRCode.toDataURL(vals().link, { width: 1200, margin: 2, errorCorrectionLevel: 'M', color: { dark: '#0b0f1f', light: '#ffffff' } });
		download(`${slug()}-review-qr.png`, url);
		track('review_qr_download', { format: 'png' });
	});

	document.getElementById('rr-svg')!.addEventListener('click', async () => {
		const svg = await QRCode.toString(vals().link, { type: 'svg', margin: 2, errorCorrectionLevel: 'M', color: { dark: '#0b0f1f', light: '#ffffff' } });
		download(`${slug()}-review-qr.svg`, URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' })));
		track('review_qr_download', { format: 'svg' });
	});

	function roundRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
		ctx.beginPath();
		ctx.moveTo(x + r, y);
		ctx.arcTo(x + w, y, x + w, y + h, r);
		ctx.arcTo(x + w, y + h, x, y + h, r);
		ctx.arcTo(x, y + h, x, y, r);
		ctx.arcTo(x, y, x + w, y, r);
		ctx.closePath();
	}

	function fitText(ctx: CanvasRenderingContext2D, text: string, maxWidth: number, size: number, weight: number, family: string) {
		let s = size;
		do {
			ctx.font = `${weight} ${s}px ${family}`;
			s -= 2;
		} while (ctx.measureText(text).width > maxWidth && s > 24);
	}

	document.getElementById('rr-card')!.addEventListener('click', async () => {
		await document.fonts.ready;
		const v = vals();
		const W = 1200;
		const H = 1650;
		const c = document.createElement('canvas');
		c.width = W;
		c.height = H;
		const ctx = c.getContext('2d')!;
		const display = '"Unbounded Variable", "Arial Black", sans-serif';
		const body = '"Inter Variable", Arial, sans-serif';

		ctx.fillStyle = '#fffdf8';
		ctx.fillRect(0, 0, W, H);
		// card
		ctx.fillStyle = '#0b0f1f';
		roundRect(ctx, 76, 76, W - 140, H - 140, 56);
		ctx.fill();
		ctx.fillStyle = '#ffd43b';
		ctx.lineWidth = 8;
		ctx.strokeStyle = '#0b0f1f';
		roundRect(ctx, 60, 60, W - 140, H - 140, 56);
		ctx.fill();
		ctx.stroke();

		ctx.fillStyle = '#0b0f1f';
		ctx.textAlign = 'center';
		ctx.font = `700 46px ${body}`;
		ctx.fillText('Happy with our work?', W / 2 - 10, 230);
		fitText(ctx, 'Leave us a Google review', W - 260, 76, 800, display);
		ctx.fillText('Leave us a Google review', W / 2 - 10, 335);

		// stars
		ctx.fillStyle = '#2b4bff';
		ctx.font = `800 64px ${body}`;
		ctx.fillText('★ ★ ★ ★ ★', W / 2 - 10, 430);

		// QR panel
		const size = 640;
		const qx = (W - size) / 2 - 10;
		const qy = 500;
		ctx.fillStyle = '#0b0f1f';
		roundRect(ctx, qx - 30 + 12, qy - 30 + 12, size + 60, size + 60, 36);
		ctx.fill();
		ctx.fillStyle = '#ffffff';
		roundRect(ctx, qx - 30, qy - 30, size + 60, size + 60, 36);
		ctx.fill();
		ctx.lineWidth = 6;
		ctx.stroke();
		const qr = document.createElement('canvas');
		await QRCode.toCanvas(qr, v.link, { width: size, margin: 0, errorCorrectionLevel: 'M', color: { dark: '#0b0f1f', light: '#ffffff' } });
		ctx.drawImage(qr, qx, qy, size, size);

		ctx.fillStyle = '#0b0f1f';
		ctx.font = `600 40px ${body}`;
		ctx.fillText('Point your phone camera at the code', W / 2 - 10, qy + size + 110);
		if (v.business) {
			fitText(ctx, v.business, W - 280, 60, 800, display);
			ctx.fillText(v.business, W / 2 - 10, qy + size + 205);
		}
		ctx.font = `500 34px ${body}`;
		ctx.fillText('Thank you for supporting a local business', W / 2 - 10, H - 160);

		download(`${slug()}-review-card.png`, c.toDataURL('image/png'));
		track('review_qr_download', { format: 'card' });
	});
</script>
